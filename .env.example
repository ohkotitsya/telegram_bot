# ---------------------------------------------------------------------------
# Environment template — copy to .env and fill in real values.
#   cp .env.example .env
# This file IS committed to git, so NEVER put real secrets here.
# ---------------------------------------------------------------------------

# Telegram Bot Token — get it from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API key — https://console.anthropic.com/
# Alternative: set ANTHROPIC_AUTH_TOKEN (+ ANTHROPIC_BASE_URL) to use a proxy.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — overrides the model used by the bot.
# ANTHROPIC_MODEL=claude-sonnet-5-5
