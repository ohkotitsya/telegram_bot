# Normalize line endings on commit (text files) so the deploy host, which is
# almost always Linux, always checks out LF — independent of the developer's
# local core.autocrlf setting.
* text=auto eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary

# Keep .env examples as plain text
.env.example text eol=lf
